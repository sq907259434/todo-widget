{
  "name": "todo-card",
  "productName": "TodoCard",
  "version": "1.0.2",
  "description": "待办清单 —— 桌面待办小卡，鼠标碰到展开，平时只剩条目（Electron 独立版）",
  "author": {
    "name": "WeatherWidget Contributors"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "python tools/make-icon.py icon.png icon.ico",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.todocard.desktop",
    "productName": "TodoCard",
    "copyright": "Copyright © 2026 WeatherWidget Contributors",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "todo.html",
      "icon.png",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "待办清单",
      "uninstallDisplayName": "待办清单",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "multiLanguageInstaller": true,
      "language": "2052",
      "include": "build/installer.nsh",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico"
    }
  }
}
